AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

POSTGRES_DB=sakila
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MinIO: credentials used by Spark S3A and by Nessie
MINIO_ACCESS_KEY=unidata
MINIO_SECRET_KEY=supersenha

# Endpoints: nomes de servico do compose (resolve dentro dos containers
# jupyter e job; do host use as portas publicadas 19120/9000).
# NESSIE_URI ja carrega /api/v1.
MINIO_ENDPOINT=http://minio:9000
NESSIE_URI=http://nessie:19120/api/v1
NESSIE_REF=dev
